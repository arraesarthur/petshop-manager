input ClienteFilterInput {
    busca: String
    page: Int!
    size: Int!
}

input ClienteInput {
    id: ID
    nome: String!
    endereco: String!
    telefone: String!
    instagram: String!
}

input PetFilterInput {
    busca: String
    clienteId: Int
    page: Int!
    size: Int!
}

input PetInput {
    id: ID
    nome: String!
    especie: String!
    racaId: ID!
    sexo: String!
    porte: String!
    clienteId: ID!
    observacao: String
    dataNascimento: Date!
}